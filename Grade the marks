
#include <iostream>
using namespace std;

int main()
{
    int m1, m2, m3, m4, m5;
    float total, percentage;
    char grade;

    cout << "Enter marks of five subjects: ";
    cin >> m1 >> m2 >> m3 >> m4 >> m5;

    total = m1 + m2 + m3 + m4 + m5;
    percentage = total / 5;

    cout << "Percentage = " << percentage << "%" << endl;

    if (percentage >= 40)
        cout << "Result: Pass" << endl;
    else
        cout << "Result: Fail" << endl;

    if (percentage >= 75)
        grade = 'A';
    else if (percentage >= 60)
        grade = 'B';
    else if (percentage >= 50)
        grade = 'C';
    else if (percentage >= 40)
        grade = 'D';
    else
        grade = 'F';

    cout << "Grade = " << grade << endl;

    cout << "Enter grade: ";
    cin >> grade;

    switch (grade)
    {
        case 'A':
            cout << "Excellent";
            break;

        case 'B':
            cout << "Very Good";
            break;

        case 'C':
            cout << "Good";
            break;

        case 'D':
            cout << "Needs Improvement";
            break;

        case 'F':
            cout << "Fail";
            break;

        default:
            cout << "Invalid Grade";
    }

    return 0;
}
