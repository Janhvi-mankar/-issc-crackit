#include <stdio.h>
#include <math.h>

int main()
{
    float x, y, a, b, c;

    printf("Enter x and y: ");
    scanf("%f %f", &x, &y);

    // (a)
    a = x*x*x + 3*x*x + 4*x - y*y*y;

    // (b)
    b = sqrt(2*x*x + 4*y*y + x*x*x + 10);

    // (c)
    c = sqrt(4*x*x + 8*y*y + x*x*x + 5) / (2*x*x);

    printf("\n(a) = %f", a);
    printf("\n(b) = %f", b);
    printf("\n(c) = %f", c);

    return 0;
}
