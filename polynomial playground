#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    float x, y, a, b, c;

    cout << "Enter x and y: ";
    cin >> x >> y;

    // (a)
    a = x*x*x + 3*x*x + 4*x - y*y*y;

    // (b)
    b = sqrt(2*x*x + 4*y*y + x*x*x + 10);

    // (c)
    c = sqrt(4*x*x + 8*y*y + x*x*x + 5) / (2*x*x);

    cout << "\n(a) = " << a;
    cout << "\n(b) = " << b;
    cout << "\n(c) = " << c;

    return 0;
}
