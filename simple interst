
#include <iostream>
using namespace std;

int main() {
    float principal, rate, years;
    float interest, amount;

    cout << "Enter principal: ";
    cin >> principal;

    cout << "Enter annual rate: ";
    cin >> rate;

    cout << "Enter number of years: ";
    cin >> years;

    interest = (principal * rate * years) / 100;

    amount = principal + interest;

    cout << "Simple Interest = " << interest << endl;
    cout << "Total Amount = " << amount << endl;

    cout << "\nAmount at the end of each year:\n";

    for (int i = 1; i <= years; i++) {
        float yearlyInterest = (principal * rate * i) / 100;
        float yearlyAmount = principal + yearlyInterest;

        cout << "Year " << i << " = " << yearlyAmount << endl;
    }

    return 0;
}
